FROM yakirill99/ds-expedition:latest
WORKDIR /app
COPY src/expds /app/expds
COPY dockerctx/config_platform.yaml /app/config.yaml
COPY dockerctx/weights.pt /app/weights.pt

# сверка конфига и весов на этапе сборки: рассинхрон каналов/классов
# роняет сборку, а не инференс на платформе
RUN python -c "from expds.pipeline_config import load_pipeline_config as L; from expds.models.checkpoint import load_checkpoint; c=L('/app/config.yaml'); load_checkpoint('/app/weights.pt', channel_names=c.data.channels, classes=c.targets.classes); print('config <-> weights: OK,', len(c.data.channels), 'каналов,', len(c.targets.classes), 'классов')"

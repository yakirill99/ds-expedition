# Пример переменных окружения для Django.
# Скопируйте в .env и измените значения.

SECRET_KEY=dev-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///web/db.sqlite3

# --- Хранилище карт (тайлов) ---
# filesystem | s3
MAP_STORAGE_BACKEND=filesystem
MAP_STORAGE_ROOT=web/tiles
MAP_TILE_URL_PREFIX=/viz/tiles/
MAP_S3_BUCKET=
MAP_S3_ENDPOINT_URL=
